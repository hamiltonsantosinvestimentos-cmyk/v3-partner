    {
      "parameters": {
        "jsCode": "// Error handler — update extraction status to 'error' in Supabase\nconst error = $input.item.json.error?.message ?? 'Erro desconhecido no W9';\nconst webhook = $('Webhook W9').item?.json?.body ?? {};\n\nreturn [{\n  json: {\n    extraction_id: webhook.extraction_id,\n    error_message: String(error).substring(0, 500)\n  }\n}];"
      },
