{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/n8n-keepalive",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/contratos/lembrete",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron/assinaturas-vencendo",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/followups",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/cold-leads",
      "schedule": "0 9 * * 1,3,5"
    }
  ],
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "creative-engine": {
      "entrypoint": "services/creative-engine",
      "routePrefix": "/_/creative-engine"
    }
  }
}
